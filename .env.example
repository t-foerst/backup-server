# --- Netbird ---
# Setup key aus deinem Netbird-Dashboard: Settings -> Setup Keys
NETBIRD_SETUP_KEY=

# Nur noetig bei selbst gehostetem Netbird-Management-Server.
# Fuer Netbird Cloud (app.netbird.io) diese Zeile unveraendert lassen.
NETBIRD_MANAGEMENT_URL=https://api.netbird.io

# Optional: Name, unter dem dieser Peer im Netbird-Dashboard erscheint
NETBIRD_HOSTNAME=backup-server

# --- Garage ---
# Generieren mit: openssl rand -hex 32
GARAGE_RPC_SECRET=

# Generieren mit: openssl rand -base64 32
GARAGE_ADMIN_TOKEN=

# S3 Access Key ID fuer den automatisch angelegten Default-Bucket
# Generieren mit: echo "GK$(openssl rand -hex 12)"
GARAGE_DEFAULT_ACCESS_KEY=

# S3 Secret Access Key fuer den automatisch angelegten Default-Bucket
# Generieren mit: openssl rand -hex 32
GARAGE_DEFAULT_SECRET_KEY=

# Name des Buckets, der beim ersten Start automatisch angelegt wird
GARAGE_DEFAULT_BUCKET=backups
